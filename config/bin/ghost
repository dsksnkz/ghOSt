#!/usr/bin/env bash
# ghOSt command line.
set -u
runtime="${XDG_RUNTIME_DIR:-/tmp}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/ghost"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
shell_lock="$runtime/ghost-shell.lock"
shell_output="$runtime/ghost-shell.out"

compositor_alive() {
    for _ in 1 2 3; do
        hyprctl version >/dev/null 2>&1 && return 0
        sleep 1 9>&-
    done
    return 1
}

# Hyprland lists FALLBACK while nothing is connected; only a real output counts.
display_connected() {
    hyprctl monitors 2>/dev/null | grep '^Monitor ' | grep -qv '^Monitor FALLBACK '
}

record_exit() {
    mkdir -p "$state"
    {
        printf '%s exit %s after %ss\n' "$(date '+%F %T')" "$1" "$2"
        tail -n 8 "$shell_output"
        echo
    } >>"$state/shell-restarts.log"
    # Keep the newest entries only.
    tail -n 400 "$state/shell-restarts.log" >"$state/shell-restarts.log.new" &&
        mv "$state/shell-restarts.log.new" "$state/shell-restarts.log"
}

# Runs the shell and brings it back unless it was asked to stop. fd 9 holds the
# lock, so it is closed for everything that could outlive this process.
supervise() {
    exec 9>>"$shell_lock"
    # A previous session's supervisor can take a few seconds to notice it ended.
    flock -w 6 9 || return 0
    truncate -s 0 "$shell_lock"
    echo $$ >&9
    local delay=1 started status
    while compositor_alive; do
        if ! display_connected; then
            sleep 1 9>&-
            continue
        fi
        started=$SECONDS
        quickshell -n -c ghost-bar >"$shell_output" 2>&1 9>&-
        status=$?
        if [ "$status" -eq 0 ] &&
            tail -n 2 "$shell_output" | grep -qE 'Exiting due to IPC request|already running'; then
            return 0
        fi
        # The session ending takes the shell with it; that is not a failure.
        sleep 1 9>&-
        compositor_alive || return 0
        record_exit "$status" "$((SECONDS - started))"
        # Only a shell that keeps failing straight away waits longer.
        if [ "$((SECONDS - started))" -lt 30 ]; then
            sleep "$delay" 9>&-
            delay=$((delay < 30 ? delay * 2 : 30))
        else
            delay=1
        fi
    done
}

start_shell() {
    setsid -f "$0" supervise >/dev/null 2>&1 </dev/null
}

# Stops the supervisor first, so that it cannot restart what is being stopped.
stop_shell() {
    local pid
    pid=$(cat "$shell_lock" 2>/dev/null)
    if [ -n "$pid" ] && tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q ' supervise '; then
        kill "$pid" 2>/dev/null
    fi
    quickshell kill -c ghost-bar >/dev/null 2>&1
    # Starting before the old instance has exited would be refused.
    for _ in {1..30}; do
        quickshell list -c ghost-bar 2>&1 | grep -q "No running instances" && return 0
        sleep 0.1
    done
    echo "ghOSt shell did not stop" >&2
    return 1
}

# Only one shell runs at a time. Its wrapper goes first, or it would restart it.
stop_macshell() {
    pkill -f '^sh .*/macshell-start$' 2>/dev/null
    quickshell kill -c MacShell >/dev/null 2>&1
}

restart_shell() {
    stop_macshell
    stop_shell || return 1
    start_shell
    for _ in {1..50}; do
        if quickshell ipc -c ghost-bar call bar status >/dev/null 2>&1; then
            echo "ghOSt shell restarted"
            return 0
        fi
        sleep 0.1
    done
    echo "ghOSt shell did not start. Log: quickshell log -c ghost-bar" >&2
    return 1
}

# A lock client that dies leaves the session locked with nothing to unlock it,
# so it is started again until it exits on its own after a correct password.
lock_session() {
    if [ ! -e /etc/pam.d/hyprlock ]; then
        echo "Not locking: /etc/pam.d/hyprlock is missing, so no password could unlock. Install hyprlock." >&2
        return 1
    fi
    exec 9>>"$runtime/ghost-lock.lock"
    flock -n 9 || return 0
    local status delay=0.2
    while :; do
        quickshell -n --path "$config/quickshell/ghost-bar/lock.qml" >/dev/null 2>&1 9>&-
        status=$?
        [ "$status" -eq 0 ] && return 0
        compositor_alive || return "$status"
        sleep "$delay" 9>&-
        delay=2
    done
}

# The wallpaper chosen in Settings, or the bundled one until there is a choice.
apply_wallpaper() {
    local file
    file=$(python3 -c 'import json, sys
try:
    print(json.load(open(sys.argv[1])).get("wallpaper", ""))
except (OSError, ValueError):
    pass' "$config/ghost/settings.json" 2>/dev/null)
    [ -f "$file" ] || file="${XDG_DATA_HOME:-$HOME/.local/share}/ghost/wallpaper.webp"
    [ -f "$file" ] || return 1
    awww query >/dev/null 2>&1 || setsid -f awww-daemon >/dev/null 2>&1 </dev/null
    for _ in {1..50}; do
        awww query >/dev/null 2>&1 && break
        sleep 0.1
    done
    awww img --transition-type none "$file"
}

# Opens the Intro the first time a session starts after installing.
first_intro() {
    [ -e "$state/intro-shown" ] && return 0
    for _ in {1..150}; do
        if quickshell ipc -c ghost-bar call bar intro >/dev/null 2>&1; then
            mkdir -p "$state"
            touch "$state/intro-shown"
            return 0
        fi
        sleep 0.2
    done
    return 1
}

# Reads one value recorded by the installer.
manifest_value() {
    python3 -c 'import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")
except (OSError, ValueError):
    pass' "$state/install.json" "$1" 2>/dev/null
}

# Checks GitHub for a newer ghOSt and reinstalls it after asking.
update_ghost() {
    local source installed latest missing answer
    source=$(manifest_value source)
    if [ -z "$source" ] || ! git -C "$source" rev-parse --git-dir >/dev/null 2>&1; then
        source="${XDG_DATA_HOME:-$HOME/.local/share}/ghost/source"
        if ! git -C "$source" rev-parse --git-dir >/dev/null 2>&1; then
            echo "Downloading ghOSt to $source"
            mkdir -p "$(dirname "$source")"
            git clone --quiet https://github.com/dsksnkz/ghOSt.git "$source" || {
                echo "Could not download ghOSt. Check the connection and try again." >&2
                return 1
            }
        fi
    fi
    echo "Checking for updates"
    if ! git -C "$source" fetch --quiet 2>/dev/null; then
        echo "Could not reach GitHub. Check the connection and try again." >&2
        return 1
    fi
    if ! latest=$(git -C "$source" rev-parse --verify --quiet '@{upstream}'); then
        echo "$source does not follow a GitHub branch." >&2
        return 1
    fi
    installed=$(manifest_value commit)
    if [ "$installed" = "$latest" ]; then
        echo "ghOSt is up to date ($(git -C "$source" log -1 --format='%h %cs' "$latest"))."
        return 0
    fi
    echo
    if [ -n "$installed" ] && git -C "$source" merge-base --is-ancestor "$installed" "$latest" 2>/dev/null; then
        echo "$(git -C "$source" rev-list --count "$installed..$latest") new changes:"
        git -C "$source" log --format='  %s' "$installed..$latest" | head -n 12
    else
        echo "Latest changes:"
        git -C "$source" log --format='  %s' -n 5 "$latest"
    fi
    echo
    read -r -p "Update ghOSt? [y/N] " answer
    case "$answer" in [yY]*) ;; *) echo "Nothing was changed."; return 0 ;; esac
    if [ "$(git -C "$source" rev-parse HEAD)" != "$latest" ]; then
        if [ -n "$(git -C "$source" status --porcelain --untracked-files=no)" ]; then
            echo "$source has local changes. Commit or stash them, then run ghost update again." >&2
            return 1
        fi
        if ! git -C "$source" merge --quiet --ff-only '@{upstream}'; then
            echo "$source has commits that are not on GitHub, so it cannot be updated automatically." >&2
            return 1
        fi
    fi
    # New packages need sudo; ask before the progress bar takes over the terminal.
    missing=$(python3 "$source/scripts/install.py" --list-missing)
    if [ -n "$missing" ]; then
        echo "New packages: $missing"
        sudo -v || return 1
    fi
    python3 "$source/scripts/install.py" --activate --update --progress
}

case "${1:-}" in
    intro) first_intro ;;
    wallpaper) apply_wallpaper ;;
    shell) restart_shell ;;
    start)
        stop_macshell
        start_shell
        ;;
    stop) stop_shell ;;
    supervise) supervise ;;
    lock) lock_session ;;
    update) update_ghost ;;
    *)
        cat >&2 <<'EOF'
Usage: ghost shell    Restart the ghOSt shell
       ghost start    Start the shell and keep it running
       ghost stop     Stop the shell
       ghost lock     Lock the session
       ghost update   Check for updates and install them
       ghost wallpaper    Apply the wallpaper
EOF
        [ $# -eq 0 ] || exit 2
        ;;
esac
